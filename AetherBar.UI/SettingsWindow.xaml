<Window x:Class="AetherBar.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AetherBar Settings"
        Width="680" Height="520"
        MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource WindowBackground}"
        ShowInTaskbar="True"
        ResizeMode="NoResize"
        MouseLeftButtonDown="OnTitleBarMouseDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      CornerRadius="10"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
<Border Grid.Row="0" Background="{DynamicResource TitleBarBg}"
        CornerRadius="10,10,0,0">
    <Grid Margin="16,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="&#xE763;" FontFamily="Segoe MDL2 Assets"
                       FontSize="14" Foreground="{DynamicResource FluentAccent}"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="AetherBar Settings"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"
                       VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                    VerticalAlignment="Center">
            <Button x:Name="MinimizeBtn" Content="&#xE921;"
                    FontFamily="Segoe MDL2 Assets" FontSize="10"
                    Width="40" Height="28"
                    Background="Transparent" Foreground="{DynamicResource TextSecondary}"
                    BorderThickness="0"
                    Click="OnMinimizeClick"/>
            <Button x:Name="CloseBtn" Content="&#xE8BB;"
                    FontFamily="Segoe MDL2 Assets" FontSize="10"
                    Width="40" Height="28"
                    Background="Transparent" Foreground="{DynamicResource TextSecondary}"
                    BorderThickness="0"
                    Margin="4,0,0,0"
                    Click="OnCloseClick"/>
        </StackPanel>
    </Grid>
</Border>

            <!-- Content -->
            <TabControl Grid.Row="1" Style="{StaticResource FluentTabControl}"
                        Background="Transparent">

                <!-- === VISUALIZER TAB === -->
                <TabItem Header="Visualizer" Tag="&#xE763;">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden"
                                  Background="Transparent">
                        <StackPanel>

                            <!-- Card: Mode + Color Theme -->
                            <Border Style="{StaticResource FluentCard}">
                                <StackPanel>
                                    <TextBlock Text="MODE &amp; APPEARANCE" Style="{StaticResource CardTitle}"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="MODE" Style="{StaticResource SectionHeader}"/>
                                            <ComboBox x:Name="VisualizerModeCombo"
                                                      
                                                      SelectedIndex="0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="COLOR THEME" Style="{StaticResource SectionHeader}"/>
                                            <ComboBox x:Name="ColorThemeCombo"
                                                      
                                                      SelectedIndex="0"
                                                      SelectionChanged="OnSettingChanged"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border x:Name="ColorPreview"
                                            Height="36" CornerRadius="6"
                                            Background="#FF4444"
                                            BorderThickness="1" BorderBrush="{DynamicResource CardBorder}"
                                            Margin="0,12,0,0"/>

                                    <!-- Custom Color Panel -->
                                    <Border x:Name="CustomColorPanel" Visibility="Collapsed"
                                            Background="{DynamicResource CustomColorPanelBg}" CornerRadius="6"
                                            BorderThickness="1" BorderBrush="{DynamicResource CardBorder}"
                                            Padding="12" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="CUSTOM COLOR" Style="{StaticResource SectionHeader}" Margin="0,0,8,0"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid Grid.Column="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="R" Foreground="#FF4444" Width="14" VerticalAlignment="Center" FontSize="12"/>
                                                    <Slider Grid.Column="1" x:Name="CustomRSlider"
                                                            
                                                            Minimum="0" Maximum="255" TickFrequency="1"
                                                            ValueChanged="OnSettingChanged"/>
                                                    <TextBlock Grid.Column="2" x:Name="CustomRText" Text="0" Style="{StaticResource SliderValue}" Width="26"/>
                                                </Grid>
                                                <Grid Grid.Column="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="G" Foreground="#44FF44" Width="14" VerticalAlignment="Center" FontSize="12"/>
                                                    <Slider Grid.Column="1" x:Name="CustomGSlider"
                                                            
                                                            Minimum="0" Maximum="255" TickFrequency="1"
                                                            ValueChanged="OnSettingChanged"/>
                                                    <TextBlock Grid.Column="2" x:Name="CustomGText" Text="204" Style="{StaticResource SliderValue}" Width="26"/>
                                                </Grid>
                                                <Grid Grid.Column="4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="B" Foreground="#4444FF" Width="14" VerticalAlignment="Center" FontSize="12"/>
                                                    <Slider Grid.Column="1" x:Name="CustomBSlider"
                                                            
                                                            Minimum="0" Maximum="255" TickFrequency="1"
                                                            ValueChanged="OnSettingChanged"/>
                                                    <TextBlock Grid.Column="2" x:Name="CustomBText" Text="255" Style="{StaticResource SliderValue}" Width="26"/>
                                                </Grid>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Card: Adjustments -->
                            <Border Style="{StaticResource FluentCard}">
                                <StackPanel>
                                    <TextBlock Text="ADJUSTMENTS" Style="{StaticResource CardTitle}"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="OPACITY" Style="{StaticResource SectionHeader}" Grid.Column="0"/>
                                        <TextBlock x:Name="OpacityValue" Text="0.5" Style="{StaticResource SliderValue}" Grid.Column="1"/>
                                    </Grid>
                                    <Slider x:Name="OpacitySlider"
                                            
                                            Minimum="0.1" Maximum="1.0" TickFrequency="0.1"
                                            ValueChanged="OnSettingChanged"/>

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="BAR COUNT" Style="{StaticResource SectionHeader}" Grid.Column="0"/>
                                        <TextBlock x:Name="BarCountValue" Text="32" Style="{StaticResource SliderValue}" Grid.Column="1"/>
                                    </Grid>
                                    <Slider x:Name="BarCountSlider"
                                            
                                            Minimum="8" Maximum="256" TickFrequency="8"
                                            ValueChanged="OnSettingChanged"/>

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="SENSITIVITY" Style="{StaticResource SectionHeader}" Grid.Column="0"/>
                                        <TextBlock x:Name="SensitivityValue" Text="1.0" Style="{StaticResource SliderValue}" Grid.Column="1"/>
                                    </Grid>
                                    <Slider x:Name="SensitivitySlider"
                                            
                                            Minimum="0.1" Maximum="15.0" TickFrequency="0.1"
                                            ValueChanged="OnSettingChanged"/>

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="THRESHOLD (NOISE GATE)" Style="{StaticResource SectionHeader}" Grid.Column="0"/>
                                        <TextBlock x:Name="ThresholdValue" Text="0.0" Style="{StaticResource SliderValue}" Grid.Column="1"/>
                                    </Grid>
                                    <Slider x:Name="ThresholdSlider"
                                            
                                            Minimum="0.0" Maximum="0.5" TickFrequency="0.02"
                                            ValueChanged="OnSettingChanged"/>

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="BAR START OFFSET (SKIP LOW FREQS)" Style="{StaticResource SectionHeader}" Grid.Column="0"/>
                                        <TextBlock x:Name="BarStartOffsetValue" Text="0" Style="{StaticResource SliderValue}" Grid.Column="1"/>
                                    </Grid>
                                    <Slider x:Name="BarStartOffsetSlider"
                                            
                                            Minimum="0" Maximum="250" TickFrequency="1"
                                            ValueChanged="OnSettingChanged"/>

                                    <CheckBox x:Name="ShowPeakCheck"
                                              Content="Show Peak Indicator"
                                              
                                              Margin="0,16,0,0"
                                              Checked="OnSettingChanged"
                                              Unchecked="OnSettingChanged"/>

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="VISUALIZER HEIGHT" Style="{StaticResource SectionHeader}" Grid.Column="0"/>
                                        <TextBlock x:Name="VisualizerHeightValue" Text="22" Style="{StaticResource SliderValue}" Grid.Column="1"/>
                                    </Grid>
                                    <Slider x:Name="VisualizerHeightSlider"
                                            
                                            Minimum="10" Maximum="48" TickFrequency="2"
                                            ValueChanged="OnSettingChanged"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- === TASKBAR TAB === -->
                <TabItem Header="Taskbar" Tag="&#xE7C4;">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden"
                                  Background="Transparent">
                        <StackPanel>

                            <!-- Card: Position & Size -->
                            <Border Style="{StaticResource FluentCard}">
                                <StackPanel>
                                    <TextBlock Text="POSITION &amp; SIZE" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Text="POSITION" Style="{StaticResource SectionHeader}"/>
                                    <ComboBox x:Name="PositionCombo"
                                              
                                              SelectedIndex="0"
                                              SelectionChanged="OnSettingChanged"/>

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="WIDGET WIDTH" Style="{StaticResource SectionHeader}" Grid.Column="0"/>
                                        <TextBlock x:Name="WidthValue" Text="180" Style="{StaticResource SliderValue}" Grid.Column="1"/>
                                    </Grid>
                                    <Slider x:Name="WidthSlider"
                                            
                                            Minimum="100" Maximum="800" TickFrequency="10"
                                            ValueChanged="OnSettingChanged"/>

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="HORIZONTAL OFFSET" Style="{StaticResource SectionHeader}" Grid.Column="0"/>
                                        <TextBlock x:Name="OffsetValue" Text="0" Style="{StaticResource SliderValue}" Grid.Column="1"/>
                                    </Grid>
                                    <Slider x:Name="OffsetSlider"
                                            
                                            Minimum="-100" Maximum="2000" TickFrequency="10"
                                            ValueChanged="OnSettingChanged"/>

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="PADDING HORIZONTAL" Style="{StaticResource SectionHeader}" Grid.Column="0"/>
                                        <TextBlock x:Name="PaddingXValue" Text="2" Style="{StaticResource SliderValue}" Grid.Column="1"/>
                                    </Grid>
                                    <Slider x:Name="PaddingXSlider"
                                            
                                            Minimum="0" Maximum="20" TickFrequency="1"
                                            ValueChanged="OnSettingChanged"/>

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="PADDING VERTICAL" Style="{StaticResource SectionHeader}" Grid.Column="0"/>
                                        <TextBlock x:Name="PaddingYValue" Text="2" Style="{StaticResource SliderValue}" Grid.Column="1"/>
                                    </Grid>
                                    <Slider x:Name="PaddingYSlider"
                                            
                                            Minimum="0" Maximum="20" TickFrequency="1"
                                            ValueChanged="OnSettingChanged"/>
                                </StackPanel>
                            </Border>

                            <!-- Card: Title -->
                            <Border Style="{StaticResource FluentCard}">
                                <StackPanel>
                                    <TextBlock Text="TITLE" Style="{StaticResource CardTitle}"/>
                                    <CheckBox x:Name="ShowSongTitleCheck"
                                              Content="Show Song Title"
                                              
                                              Checked="OnSettingChanged"
                                              Unchecked="OnSettingChanged"/>
                                    <TextBlock Text="TEXT COLOR" Style="{StaticResource SectionHeader}" Margin="0,8,0,0"/>
                                    <ComboBox x:Name="WidgetTextColorCombo"
                                              
                                              SelectedIndex="0"
                                              SelectionChanged="OnSettingChanged"/>
                                    <Border x:Name="WidgetTextColorPanel" Visibility="Collapsed"
                                            Background="{DynamicResource CustomColorPanelBg}" CornerRadius="6"
                                            BorderThickness="1" BorderBrush="{DynamicResource CardBorder}"
                                            Padding="10" Margin="0,8,0,0">
                                        <StackPanel>
                                            <TextBlock Text="CUSTOM COLOR" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid Grid.Column="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="R" Foreground="#FF4444" Width="14" VerticalAlignment="Center" FontSize="12"/>
                                                    <Slider Grid.Column="1" x:Name="WidgetTextRSlider"
                                                            
                                                            Minimum="0" Maximum="255" TickFrequency="1"
                                                            ValueChanged="OnSettingChanged"/>
                                                    <TextBlock Grid.Column="2" x:Name="WidgetTextRText" Text="255" Style="{StaticResource SliderValue}" Width="26"/>
                                                </Grid>
                                                <Grid Grid.Column="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="G" Foreground="#44FF44" Width="14" VerticalAlignment="Center" FontSize="12"/>
                                                    <Slider Grid.Column="1" x:Name="WidgetTextGSlider"
                                                            
                                                            Minimum="0" Maximum="255" TickFrequency="1"
                                                            ValueChanged="OnSettingChanged"/>
                                                    <TextBlock Grid.Column="2" x:Name="WidgetTextGText" Text="255" Style="{StaticResource SliderValue}" Width="26"/>
                                                </Grid>
                                                <Grid Grid.Column="4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="B" Foreground="#4444FF" Width="14" VerticalAlignment="Center" FontSize="12"/>
                                                    <Slider Grid.Column="1" x:Name="WidgetTextBSlider"
                                                            
                                                            Minimum="0" Maximum="255" TickFrequency="1"
                                                            ValueChanged="OnSettingChanged"/>
                                                    <TextBlock Grid.Column="2" x:Name="WidgetTextBText" Text="255" Style="{StaticResource SliderValue}" Width="26"/>
                                                </Grid>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="WidgetTextColorPreview"
                                            Height="36" CornerRadius="6"
                                            Background="#FF4444"
                                            BorderThickness="1" BorderBrush="{DynamicResource CardBorder}"
                                            Margin="0,12,0,0"/>
                                    <CheckBox x:Name="AutoHideCheck"
                                              Content="Auto-hide with taskbar"
                                              
                                              Checked="OnSettingChanged"
                                              Unchecked="OnSettingChanged"/>
                                </StackPanel>
                            </Border>

                            <!-- Card: Album Art -->
                            <Border Style="{StaticResource FluentCard}">
                                <StackPanel>
                                    <TextBlock Text="ALBUM ART" Style="{StaticResource CardTitle}"/>
                                    <CheckBox x:Name="ShowAlbumArtCheck"
                                              Content="Show Album Art"
                                              
                                              Checked="OnSettingChanged"
                                              Unchecked="OnSettingChanged"/>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="SIZE" Style="{StaticResource SectionHeader}" Grid.Column="0"/>
                                        <TextBlock x:Name="AlbumArtSizeValue" Text="24" Style="{StaticResource SliderValue}" Grid.Column="1"/>
                                    </Grid>
                                    <Slider x:Name="AlbumArtSizeSlider"
                                            
                                            Minimum="16" Maximum="48" TickFrequency="2"
                                            ValueChanged="OnSettingChanged"/>

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="CORNER RADIUS" Style="{StaticResource SectionHeader}" Grid.Column="0"/>
                                        <TextBlock x:Name="AlbumArtRadiusValue" Text="4" Style="{StaticResource SliderValue}" Grid.Column="1"/>
                                    </Grid>
                                    <Slider x:Name="AlbumArtRadiusSlider"
                                            
                                            Minimum="0" Maximum="24" TickFrequency="1"
                                            ValueChanged="OnSettingChanged"/>

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="OPACITY" Style="{StaticResource SectionHeader}" Grid.Column="0"/>
                                        <TextBlock x:Name="AlbumArtOpacityValue" Text="1.0" Style="{StaticResource SliderValue}" Grid.Column="1"/>
                                    </Grid>
                                    <Slider x:Name="AlbumArtOpacitySlider"
                                            
                                            Minimum="0.1" Maximum="1.0" TickFrequency="0.1"
                                            ValueChanged="OnSettingChanged"/>
                                </StackPanel>
                            </Border>

                            <!-- Card: Widget Events -->
                            <Border Style="{StaticResource FluentCard}">
                                <StackPanel>
                                    <TextBlock Text="WIDGET EVENTS" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Text="DOUBLE-CLICK ACTION" Style="{StaticResource SectionHeader}"/>
                                    <ComboBox x:Name="DoubleClickActionCombo"
                                              
                                              SelectedIndex="0"
                                              SelectionChanged="OnSettingChanged"/>
                                    <TextBox x:Name="DoubleClickValueBox"
                                             Text=""
                                             Height="32" Padding="8,4" FontSize="13"
                                             VerticalContentAlignment="Center"
                                             Margin="0,6,0,0"
                                             TextChanged="OnSettingChanged"
                                             Visibility="Collapsed"
                                             Background="{DynamicResource WindowBackground}"
                                             Foreground="{DynamicResource TextPrimary}"
                                             BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"/>
                                    <TextBlock Text="RIGHT-CLICK ACTION" Style="{StaticResource SectionHeader}" Margin="0,12,0,0"/>
                                    <ComboBox x:Name="RightClickActionCombo"
                                              
                                              SelectedIndex="0"
                                              SelectionChanged="OnSettingChanged"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- === EFFECTS TAB === -->
                <TabItem Header="Effects" Tag="&#xE7F0;">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden"
                                  Background="Transparent">
                        <StackPanel>

                            <!-- Card: Background -->
                            <Border Style="{StaticResource FluentCard}">
                                <StackPanel>
                                    <TextBlock Text="BACKGROUND" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Text="EFFECT" Style="{StaticResource SectionHeader}"/>
                                    <ComboBox x:Name="BgEffectCombo"
                                              
                                              SelectedIndex="0"
                                              SelectionChanged="OnSettingChanged"/>
                                </StackPanel>
                            </Border>

                            <!-- Card: Visual -->
                            <Border Style="{StaticResource FluentCard}">
                                <StackPanel>
                                    <TextBlock Text="VISUAL" Style="{StaticResource CardTitle}"/>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="CORNER RADIUS" Style="{StaticResource SectionHeader}" Grid.Column="0"/>
                                        <TextBlock x:Name="CornerRadiusValue" Text="4" Style="{StaticResource SliderValue}" Grid.Column="1"/>
                                    </Grid>
                                    <Slider x:Name="CornerRadiusSlider"
                                            
                                            Minimum="0" Maximum="12" TickFrequency="2"
                                            ValueChanged="OnSettingChanged"/>

                                    <CheckBox x:Name="AdaptiveThemeCheck"
                                              Content="Adaptive Theme (from Album Art)"
                                              
                                              Margin="0,12,0,0"
                                              Checked="OnSettingChanged"
                                              Unchecked="OnSettingChanged"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- === PLUGINS TAB === -->
                <TabItem Header="Plugins" Tag="&#xE71D;">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden"
                                   Background="Transparent">
                        <StackPanel>
                            <!-- No Plugins Alert -->
                            <TextBlock x:Name="NoPluginsText"
                                       Text="No plugins found. Place plugin DLLs in the 'plugins' directory."
                                       Foreground="{DynamicResource TextSecondary}"
                                       FontSize="13"
                                       HorizontalAlignment="Center"
                                       Margin="24"
                                       Visibility="Collapsed"/>

                            <!-- Plugin Settings Panel -->
                            <StackPanel x:Name="PluginSettingsPanel">
                                <!-- Card: Selection -->
                                <Border Style="{StaticResource FluentCard}">
                                    <StackPanel>
                                        <TextBlock Text="PLUGIN SELECTION" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Text="ACTIVE PLUGIN" Style="{StaticResource SectionHeader}"/>
                                        <ComboBox x:Name="PluginSelectorCombo"
                                                  SelectionChanged="OnPluginSelectionChanged"/>
                                    </StackPanel>
                                </Border>

                                <!-- Card: Layout & Styling -->
                                <Border Style="{StaticResource FluentCard}">
                                    <StackPanel>
                                        <TextBlock Text="LAYOUT &amp; ALIGNMENT" Style="{StaticResource CardTitle}"/>

                                        <CheckBox x:Name="PluginEnabledCheck"
                                                  Content="Enable Plugin"
                                                  Margin="0,0,0,12"
                                                  Checked="OnPluginSettingChanged"
                                                  Unchecked="OnPluginSettingChanged"/>
                                        
                                        <TextBlock Text="ALIGNMENT" Style="{StaticResource SectionHeader}"/>
                                        <ComboBox x:Name="PluginAlignmentCombo"
                                                  SelectionChanged="OnPluginSettingChanged"/>

                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="HORIZONTAL SHIFT / OFFSET" Style="{StaticResource SectionHeader}" Grid.Column="0"/>
                                            <TextBlock x:Name="PluginPaddingValue" Text="0" Style="{StaticResource SliderValue}" Grid.Column="1"/>
                                        </Grid>
                                        <Slider x:Name="PluginPaddingSlider"
                                                Minimum="-150" Maximum="150" TickFrequency="5"
                                                ValueChanged="OnPluginSettingChanged"/>

                                        <CheckBox x:Name="PluginCustomWidthCheck"
                                                  Content="Enable Custom Width"
                                                  Margin="0,16,0,0"
                                                  Checked="OnPluginSettingChanged"
                                                  Unchecked="OnPluginSettingChanged"/>

                                        <StackPanel x:Name="PluginWidthPanel" Margin="0,12,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="CUSTOM WIDTH" Style="{StaticResource SectionHeader}" Grid.Column="0"/>
                                                <TextBlock x:Name="PluginWidthValue" Text="150" Style="{StaticResource SliderValue}" Grid.Column="1"/>
                                            </Grid>
                                            <Slider x:Name="PluginWidthSlider"
                                                    Minimum="50" Maximum="400" TickFrequency="5"
                                                    ValueChanged="OnPluginSettingChanged"/>
                                        </StackPanel>

                                    </StackPanel>
                                </Border>

                                <!-- Card: Plugin Ordering (Drag and Drop) -->
                                <Border Style="{StaticResource FluentCard}">
                                    <StackPanel>
                                        <TextBlock Text="PLUGIN ORDERING" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Text="DRAG AND DROP ITEMS TO CHANGE ORDER" Style="{StaticResource SectionHeader}"/>
                                         <ListBox x:Name="PluginsSortListBox"
                                                  Margin="0,8,0,0"
                                                  Height="46"
                                                  Background="Transparent"
                                                  BorderBrush="Transparent"
                                                  BorderThickness="0"
                                                  Padding="0"
                                                  AllowDrop="True"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                  PreviewMouseLeftButtonDown="PluginsSortListBox_PreviewMouseLeftButtonDown"
                                                  PreviewMouseMove="PluginsSortListBox_PreviewMouseMove"
                                                  DragOver="PluginsSortListBox_DragOver"
                                                  Drop="PluginsSortListBox_Drop">
                                             <ListBox.ItemsPanel>
                                                 <ItemsPanelTemplate>
                                                     <StackPanel Orientation="Horizontal" IsItemsHost="True"/>
                                                 </ItemsPanelTemplate>
                                             </ListBox.ItemsPanel>
                                             <ListBox.ItemContainerStyle>
                                                 <Style TargetType="ListBoxItem">
                                                     <Setter Property="Background" Value="{DynamicResource TitleBarBg}"/>
                                                     <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                     <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
                                                     <Setter Property="BorderThickness" Value="1"/>
                                                     <Setter Property="Padding" Value="12,6"/>
                                                     <Setter Property="Margin" Value="0,0,8,0"/>
                                                     <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                     <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                     <Setter Property="Cursor" Value="SizeAll"/>
                                                     <Setter Property="Template">
                                                         <Setter.Value>
                                                             <ControlTemplate TargetType="ListBoxItem">
                                                                 <Border Background="{TemplateBinding Background}"
                                                                         BorderBrush="{TemplateBinding BorderBrush}"
                                                                         BorderThickness="{TemplateBinding BorderThickness}"
                                                                         CornerRadius="6"
                                                                         Padding="{TemplateBinding Padding}"
                                                                         SnapsToDevicePixels="True">
                                                                     <StackPanel Orientation="Horizontal">
                                                                         <!-- Drag handle icon -->
                                                                         <TextBlock Text="&#xE75E;" FontFamily="Segoe MDL2 Assets" 
                                                                                    FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0"
                                                                                    Foreground="{DynamicResource TextSecondary}"/>
                                                                         <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                                                     </StackPanel>
                                                                 </Border>
                                                                 <ControlTemplate.Triggers>
                                                                     <Trigger Property="IsMouseOver" Value="True">
                                                                         <Setter Property="Background" Value="{DynamicResource SurfaceAltColor}"/>
                                                                         <Setter Property="BorderBrush" Value="{DynamicResource FluentAccent}"/>
                                                                     </Trigger>
                                                                     <Trigger Property="IsSelected" Value="True">
                                                                         <Setter Property="Background" Value="{DynamicResource FluentAccent}"/>
                                                                         <Setter Property="Foreground" Value="White"/>
                                                                         <Setter Property="BorderBrush" Value="{DynamicResource FluentAccent}"/>
                                                                     </Trigger>
                                                                 </ControlTemplate.Triggers>
                                                             </ControlTemplate>
                                                         </Setter.Value>
                                                     </Setter>
                                                 </Style>
                                             </ListBox.ItemContainerStyle>
                                         </ListBox>
                                    </StackPanel>
                                </Border>

                                <!-- Card: Custom Plugin Settings -->
                                <Border x:Name="PluginCustomSettingsCard" Style="{StaticResource FluentCard}" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="CUSTOM PLUGIN SETTINGS" Style="{StaticResource CardTitle}"/>
                                        <StackPanel x:Name="CustomSettingsContainer" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- === GENERAL TAB === -->
                <TabItem Header="General" Tag="&#xE713;">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden"
                                  Background="Transparent">
                        <StackPanel>

                            <!-- Card: Startup -->
                            <Border Style="{StaticResource FluentCard}">
                                <StackPanel>
                                    <TextBlock Text="STARTUP" Style="{StaticResource CardTitle}"/>
                                    <CheckBox x:Name="StartWithWindowsCheck"
                                              Content="Start with Windows"
                                              
                                              Checked="OnSettingChanged"
                                              Unchecked="OnSettingChanged"/>
                                    <CheckBox x:Name="StartMinimizedCheck"
                                              Content="Start minimized (system tray)"
                                              
                                              Checked="OnSettingChanged"
                                              Unchecked="OnSettingChanged"/>
                                </StackPanel>
                            </Border>

                            <!-- Card: Behavior -->
                            <Border Style="{StaticResource FluentCard}">
                                <StackPanel>
                                    <TextBlock Text="BEHAVIOR" Style="{StaticResource CardTitle}"/>
                                    <CheckBox x:Name="DarkModeCheck"
                                              Content="Dark Mode (White Mode)"
                                              
                                              Margin="0,0,0,4"
                                              Checked="OnSettingChanged"
                                              Unchecked="OnSettingChanged"/>
                                    <CheckBox x:Name="GameModeCheck"
                                              Content="Game Mode (auto-hide on fullscreen)"
                                              
                                              Checked="OnSettingChanged"
                                              Unchecked="OnSettingChanged"/>
                                    <CheckBox x:Name="UpdateCheck"
                                              Content="Check for updates"
                                              
                                              Checked="OnSettingChanged"
                                              Unchecked="OnSettingChanged"/>
                                </StackPanel>
                            </Border>

                            <!-- Card: About -->
                            <Border Style="{StaticResource FluentCard}">
                                <StackPanel>
                                    <TextBlock Text="ABOUT" Style="{StaticResource CardTitle}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="AetherBar" FontSize="20" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="v0.1.0" FontSize="13"
                                                   Foreground="{DynamicResource TextTertiary}"
                                                   VerticalAlignment="Center" Margin="8,0,0,2"/>
                                    </StackPanel>
                                    <TextBlock Text="Open-source Taskbar Widget Engine"
                                               Foreground="{DynamicResource TextSecondary}"
                                               Margin="0,4,0,0"/>
                                    <TextBlock Text=".NET 8 WPF · NAudio · WinRT"
                                               Foreground="{DynamicResource TextTertiary}"
                                               FontSize="11" Margin="0,6,0,0"/>
                                    <Button Content="Reset to Defaults"
                                             
                                             Background="{DynamicResource SurfaceAltColor}" Foreground="{DynamicResource TextPrimary}"
                                            Height="34"
                                            Margin="0,16,0,0"
                                            HorizontalAlignment="Left"
                                            Click="OnResetClick"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
</Window>
