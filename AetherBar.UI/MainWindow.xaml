<Window x:Class="AetherBar.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
        xmlns:vis="clr-namespace:AetherBar.UI.Visualizers"
        Title="AetherBar"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01000000"
        ShowInTaskbar="False"
        Topmost="True"
        Width="180" Height="0"
        Unloaded="OnUnloaded"
        PreviewMouseDown="OnWidgetPreviewMouseDown"
        PreviewMouseUp="OnWidgetPreviewMouseUp"
        MouseEnter="OnWidgetMouseEnter"
        MouseLeave="OnWidgetMouseLeave">
<Grid>
        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="AetherBar"/>
        <Border x:Name="WidgetContainer"
            Background="#22000000"
            CornerRadius="4"
            Margin="2">
        <Grid VerticalAlignment="Center" ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="AlbumArtBorder"
                    Grid.Row="0" Grid.Column="0"
                    Grid.RowSpan="2"
                    Width="24" Height="24"
                    Margin="3,0,2,0"
                    VerticalAlignment="Center"
                    Visibility="Collapsed"
                    CornerRadius="4"
                    Background="Transparent">
                <Image x:Name="AlbumArtImage"
                       Width="24" Height="24"
                       Stretch="UniformToFill"/>
            </Border>

            <vis:VisualizerControl x:Name="VisualizerControl"
                                   Grid.Row="0" Grid.Column="1"
                                   Height="22"
                                   Margin="2,0,4,0"
                                   VerticalAlignment="Center"
                                   Visibility="Visible"/>

            <StackPanel x:Name="PluginPanelLeft"
                        Grid.Row="0" Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Panel.ZIndex="2" />

            <StackPanel x:Name="PluginPanelCenter"
                        Grid.Row="0" Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Panel.ZIndex="2" />

            <StackPanel x:Name="PluginPanelRight"
                        Grid.Row="0" Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        Panel.ZIndex="2" />

            <Canvas x:Name="TitleClip"
                    Grid.Row="1" Grid.Column="1"
                    ClipToBounds="True"
                    Margin="2,0,4,1">
                <TextBlock x:Name="SongInfoText"
                           FontSize="10"
                           Foreground="#BBFFFFFF"
                           Visibility="Collapsed"/>
            </Canvas>
        </Grid>
    </Border>
    </Grid>
</Window>
