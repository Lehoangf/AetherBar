<Window x:Class="AetherBar.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
        xmlns:vis="clr-namespace:AetherBar.UI.Visualizers"
        Title="AetherBar"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Width="180" Height="40"
        Unloaded="OnUnloaded">
<Grid>
        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="AetherBar"/>
        <Border x:Name="WidgetContainer"
            Background="#22000000"
            CornerRadius="4"
            Margin="2">
        <Grid VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Image x:Name="AlbumArtImage"
                   Grid.Row="0" Grid.Column="0"
                   Grid.RowSpan="2"
                   Width="24" Height="24"
                   Margin="3,0,2,0"
                   VerticalAlignment="Center"
                   Visibility="Collapsed"/>

            <vis:VisualizerControl x:Name="VisualizerControl"
                                   Grid.Row="0" Grid.Column="1"
                                   Height="22"
                                   Margin="2,0,4,0"
                                   Visibility="Visible"/>

            <TextBlock x:Name="SongInfoText"
                       Grid.Row="1" Grid.Column="1"
                       FontSize="10"
                       Foreground="#BBFFFFFF"
                       TextTrimming="CharacterEllipsis"
                       Margin="2,0,4,1"
                       Visibility="Collapsed"/>
        </Grid>
    </Border>
    </Grid>
</Window>
